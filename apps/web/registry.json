          }
        },
        "@utility glass-prominent": {
          "background-color": "color-mix(in srgb, var(--primary) 85%, transparent)",
          "color": "var(--primary-foreground)",
          "-webkit-backdrop-filter": "blur(var(--material-glass-blur))\n    saturate(var(--material-glass-saturate))",
          "backdrop-filter": "blur(var(--material-glass-blur))\n    saturate(var(--material-glass-saturate))",
          "box-shadow": "var(--elevation-glass)",
          "@media (prefers-reduced-transparency: reduce)": {
            "background-color": "var(--primary)",
            "backdrop-filter": "none"
          },
          ":where([data-transparency=\"reduced\"]) &": {
            "background-color": "var(--primary)",
            "backdrop-filter": "none"
          }
        },
        "@utility hairline": {
          "box-shadow": "0 0 0 0.5px var(--separator)"
        },
        "@utility hairline-t": {
          "box-shadow": "inset 0 0.5px 0 var(--separator)"
        },
        "@utility hairline-b": {
          "box-shadow": "inset 0 -0.5px 0 var(--separator)"
        },
        "@utility pressable": {
          "transition-property": "transform, opacity, background-color",
          "transition-duration": "var(--duration-press)",
          "transition-timing-function": "var(--easing-standard)",
          "&:active": {
            "transform": "scale(0.97)",
            "opacity": "0.8"
          },
          "@media (prefers-reduced-motion: reduce)": {
            "&:active": {
              "transform": "none"
            }
          }
        }
      }
