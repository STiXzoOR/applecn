{
  "name": "@applecn/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "examples:build": "node scripts/examples-index.ts",
    "registry:data": "node scripts/registry.ts",
